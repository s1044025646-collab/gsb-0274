{
  "name": "dp-polyline-service",
  "version": "1.0.0",
  "description": "离线平面折线 Douglas-Peucker 简化与误差核验后端（API + CLI）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
